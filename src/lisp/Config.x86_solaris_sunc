# -*- Mode: makefile -*-
include Config.sparc_common

CC = cc -xlibmieee -g
CFLAGS += $(COPT)
CFLAGS += -Di386
CPP = cc -E
DEPEND_FLAGS = -xM1

ASSEM_SRC = x86-assem.S
ARCH_SRC = x86-arch.c

OS_SRC = solaris-os.c os-common.c undefineds.c elf.c
OS_LINK_FLAGS=
OS_LIBS= -lsocket -lnsl -ldl -lrt

# Sun C doesn't support -dM.
ERRNO_DUMP_MACROS = $(CC) -E -xdumpmacros=defs - 2>&1 >/dev/null
ERRNO_PREPROCESS = $(CC) -E -
